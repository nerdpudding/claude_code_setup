{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 365,
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "600000"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(nvidia-smi:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(docker inspect:*)",
      "Bash(docker rm:*)",
      "Bash(docker stop:*)",
      "Bash(docker start:*)",
      "Bash(docker run:*)",
      "Bash(docker compose:*)",
      "Bash(uv run:*)",
      "Bash(tmux:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push *)",
      "Bash(git mv *)",
      "Bash(rm /home/USER/PROJECTS/*)",
      "Bash(rm -r /home/USER/PROJECTS/*)",
      "Bash(rm -rf /home/USER/PROJECTS/*)",
      "Bash(bash /home/USER/.claude/skills/beep/beep.sh*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "fallbackModel": [
    "claude-opus-5",
    "claude-opus-4-8",
    "claude-sonnet-5-5"
  ],
  "enabledPlugins": {
    "diagram-design@diagram-design": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "diagram-design": {
      "source": {
        "source": "github",
        "repo": "cathrynlavery/diagram-design"
      }
    }
  },
  "outputStyle": "Personal Voice",
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "plansDirectory": "./claude_plans",
  "tui": "fullscreen",
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "verbose": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "This is the user's own single-user development machine and the user owns all of its GPUs and Docker. Local GPU jobs, Docker container lifecycle (run/stop/rm/logs) and starting/stopping local model servers are authorized routine dev-loop actions and should be allowed without a per-action sentence."
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/USER/.claude/skills/beep/beep.sh"
          }
        ]
      }
    ]
  }
}
